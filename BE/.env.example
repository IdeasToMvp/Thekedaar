## Backend environment (copy to .env locally)
#
# Never commit `.env`. Keep this file updated with required keys.

# Server
PORT=5000

# Supabase (server) — use service_role secret only (bypasses RLS). Do NOT use anon/publishable here.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Cloud API (dev)
# From Meta → WhatsApp → API Setup. Use a System User long-lived token in production (Graph tokens from the UI expire in ~24h).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
# Phone number ID (numeric), NOT the display phone number
WHATSAPP_PHONE_NUMBER_ID=

# Local dev only: if WhatsApp send fails, return login URL in API (set EXPOSE_LOGIN_LINK_IN_DEV=true)
EXPOSE_LOGIN_LINK_IN_DEV=

# Website / auth (public URL of FRONTEND, no trailing slash — used in WhatsApp login links)
WEB_BASE_URL=http://localhost:3000
SESSION_JWT_SECRET=
# Support email (banned account messages, optional override)
SUPPORT_EMAIL=laddi0399@gmail.com

# Razorpay (employer wallet top-up — UPI)
# Dashboard → Account & Settings → API Keys (test keys for dev, live keys for production)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Local dev: instant wallet credit without Razorpay (never enable in production)
# WALLET_DEV_TOPUP=true

# Optional (later)
OPENAI_API_KEY=
GEMINI_API_KEY=
LOG_LEVEL=info


EXPOSE_LOGIN_LINK_IN_DEV=true
NODE_ENV=development
WALLET_DEV_TOPUP=true